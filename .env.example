# Получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Получить на https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ID админа (узнать: написать @userinfobot) — ему приходят лиды и запросы "связаться с человеком".
# Можно указать НЕСКОЛЬКО админов через запятую: ADMIN_CHAT_ID=111,222
ADMIN_CHAT_ID=123456789

# Опционально: название фирмы, появится в приветствии
FIRM_NAME=Visa Experts

# Опционально: какие языки предлагает этот бот (через запятую). Если пусто — все: en,es,ru,uk.
# Для англо-испанского клона: BOT_LANGS=en,es
BOT_LANGS=

# Опционально: язык по умолчанию (должен быть среди BOT_LANGS). По умолчанию ru.
# Для англо-испанского клона: DEFAULT_LANG=en
DEFAULT_LANG=ru

# Опционально: месячный бюджет на ИИ для этого бота/фирмы (USD).
# Если задан — команда /costs покажет, сколько от бюджета осталось. 0 = выключено.
AI_BUDGET_USD=0
