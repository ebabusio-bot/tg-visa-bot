# Получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Получить на https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ID админа КЛИЕНТА (узнать: написать @userinfobot) — ему приходят ЛИДЫ, заявки
# и запросы "связаться с человеком" (бизнес-уведомления).
# Можно указать НЕСКОЛЬКО админов через запятую: ADMIN_CHAT_ID=111,222
ADMIN_CHAT_ID=123456789

# ID ВАШЕГО (оператора) чата — сюда приходят ТЕХНИЧЕСКИЕ алерты: ошибки и сбои
# бота. Отделено от ADMIN_CHAT_ID, чтобы при нескольких клиентах ВЫ видели
# поломки всех ботов, а клиент видел только свои лиды.
# Можно несколько через запятую. Если пусто — алерты идут на ADMIN_CHAT_ID (как раньше).
OWNER_CHAT_ID=

# Опционально: название фирмы. Появится отдельной строкой в приветствии клиента
# И в заголовке технических алертов (чтобы вы сразу понимали, чей бот выдал
# ошибку). Если пусто — бот без брендинга (как раньше).
FIRM_NAME=Visa Experts

# Опционально: цены УСЛУГ ФИРМЫ (без знака $). Если пусто — берутся значения по
# умолчанию (как сейчас). Госпошлины USCIS (I-140, I-485, Premium Processing,
# asylum fee) НЕ настраиваются — это факты, одинаковые для всех.
PRICE_CONSULT=300          # консультация (60–90 мин)
PRICE_PETITION=15 000      # legal service EB-1 / EB-2 NIW (подготовка I-140)
PRICE_I485_MEMBER=500      # I-485, за каждого члена семьи

# Опционально: какие языки предлагает этот бот (через запятую). Если пусто — все: en,es,ru,uk.
# Для англо-испанского клона: BOT_LANGS=en,es
BOT_LANGS=

# Опционально: язык по умолчанию (должен быть среди BOT_LANGS). По умолчанию ru.
# Для англо-испанского клона: DEFAULT_LANG=en
DEFAULT_LANG=ru

# Опционально: месячный бюджет на ИИ для этого бота/фирмы (USD).
# Если задан — команда /costs покажет, сколько от бюджета осталось. 0 = выключено.
AI_BUDGET_USD=0

# Опционально: дублировать уведомления о заявках («Записаться»/«Связаться»)
# в WhatsApp второму администратору через CallMeBot (бесплатно).
# Настройка получателя (на его телефоне): добавить контакт +34 644 84 71 89,
# отправить ему "I allow callmebot to send me messages", в ответ придёт apikey.
# Если обе переменные пусты — WhatsApp не используется (бот работает как раньше).
WHATSAPP_NOTIFY_PHONE=
CALLMEBOT_APIKEY=
